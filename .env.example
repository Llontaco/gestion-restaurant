# URL base de la API del backend
# Dev:  http://localhost:3001/api
# Prod: https://<tu-backend>.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# Client ID público de Google (login con Google). Opcional: el componente ya trae
# un valor por defecto. Créalo en https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
