# =====================================================
# BASE DE DATOS — PostgreSQL (Vercel Postgres / Neon)
# Estas variables las inyecta Vercel automáticamente al vincular la base de datos.
# Para desarrollo local, obtenlas con:  vercel env pull .env
# =====================================================
POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST/db?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST/db

# =====================================================
# CONFIGURACIÓN DEL SERVIDOR (solo ejecución local / hosts tradicionales)
# En Vercel el puerto lo gestiona la plataforma.
# =====================================================
PORT=3001

# URL pública del frontend (Vercel) para habilitar CORS en producción
# Ej: https://gestion-restaurant.vercel.app
FRONTEND_URL=

# Carpeta de imágenes subidas (no persiste en Vercel serverless)
UPLOADS_DIR="uploads"

# =====================================================
# CHATBOT — Gemini API (Google AI Studio)
# Consíguela en https://aistudio.google.com/apikey
# ¡NO la subas al repo! Va solo aquí (backend), nunca en el frontend.
# =====================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =====================================================
# LOGIN CON GOOGLE — verificación del token (audiencia)
# El mismo Client ID que usa el frontend.
# =====================================================
GOOGLE_CLIENT_ID=

# =====================================================
# MERCADO PAGO — Access Token (SECRETO, solo backend)
# Obtenlo en https://www.mercadopago.com.pe/developers → Tus integraciones
# =====================================================
MP_ACCESS_TOKEN=

# =====================================================
# NOTIFICACIONES AL CLIENTE (pago aprobado) — ambas opcionales:
# si faltan, simplemente no se envían y el pedido se registra igual.
# =====================================================
# Correo vía Gmail: contraseña de APLICACIÓN (requiere verificación en 2 pasos)
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# WhatsApp Cloud API: developers.facebook.com → app → WhatsApp → Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
