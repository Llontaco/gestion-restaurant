// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; el target de Vercel (AWS Lambda) para producción
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión pooled (PgBouncer) para las funciones serverless
  url       = env("POSTGRES_PRISMA_URL")
  // Conexión directa para migraciones / db push
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(100)
icon     String    @db.VarChar(10)
  products Product[]

  @@map("categories")
}

model Product {
  id         Int            @id @default(autoincrement())
  name       String         @db.VarChar(200)
  price      Decimal        @db.Decimal(10, 2)
  image      String?        @db.VarChar(500)
  categoryId Int
  category   Category       @relation(fields: [categoryId], references: [id])
  orderItems OrderProduct[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("products")
}

model Order {
  id           Int            @id @default(autoincrement())
  // Código público único del pedido (ej. "FC-8K3N2A"), visible para el cliente
  code         String?        @unique @db.VarChar(20)
  name         String         @db.VarChar(200)
  total        Decimal        @db.Decimal(10, 2)
  status       Boolean        @default(false)
  orderReadyAt DateTime?
  // Cuándo el admin marcó la orden como entregada (sale del display "Órdenes Listas")
  finalizedAt  DateTime?
  // Cliente que hizo el pedido (null en órdenes antiguas / anónimas)
  userId       Int?
  user         User?          @relation(fields: [userId], references: [id])
  // ─── Entrega ───
  // "PICKUP" (recojo en local) o "DELIVERY" (envío a domicilio)
  deliveryType    String   @default("PICKUP") @db.VarChar(10)
  deliveryAddress String?  @db.VarChar(300)
  // Teléfono de contacto para que el repartidor llame al llegar
  deliveryPhone   String?  @db.VarChar(20)
  deliveryLat     Float?
  deliveryLng     Float?
  // Distancia estimada desde el local (km) y cargo por delivery (S/)
  distanceKm      Float?
  deliveryFee     Decimal  @default(0) @db.Decimal(10, 2)
  // ─── Pago (Mercado Pago) ───
  // Id del pago aprobado en MP (único: evita registrar la misma compra dos veces)
  paymentId       String?  @unique @db.VarChar(60)
  paymentStatus   String?  @db.VarChar(20)
  createdAt    DateTime       @default(now())
  orderItems   OrderProduct[]
  payments     Payment[]

  @@map("orders")
}

// Registro de pagos de Mercado Pago: guarda TODOS los intentos (aprobados,
// rechazados, pendientes). La orden solo se crea con pagos aprobados, por eso
// orderId es opcional.
model Payment {
  id                Int      @id @default(autoincrement())
  // Id del pago en Mercado Pago
  mpPaymentId       String   @unique @db.VarChar(60)
  status            String   @db.VarChar(30) // approved | rejected | pending | in_process...
  statusDetail      String?  @db.VarChar(80) // accredited, cc_rejected_bad_filled_card...
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("PEN") @db.VarChar(5)
  method            String?  @db.VarChar(40) // visa, master, yape...
  methodType        String?  @db.VarChar(40) // credit_card, debit_card...
  installments      Int?
  payerEmail        String?  @db.VarChar(150)
  // Comisión de MP y neto recibido (solo en pagos aprobados)
  feeAmount         Decimal? @db.Decimal(10, 2)
  netAmount         Decimal? @db.Decimal(10, 2)
  externalReference String?  @db.VarChar(60)
  orderId           Int?
  order             Order?   @relation(fields: [orderId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payments")
}

model OrderProduct {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@map("order_products")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  // Los usuarios que se registran por Google no tienen contraseña local.
  password  String?  @db.VarChar(255)
  // "CLIENT" (por defecto) o "ADMIN". Solo el admin ve el panel de administración.
  role      String   @default("CLIENT") @db.VarChar(20)
  createdAt DateTime @default(now())
  orders    Order[]

  @@map("users")
}

// ─── Personalización / Marca del restaurante ──────────────────────────────────
// Configuración visual y empresarial editable desde "Configuración > Personalización".
// `tenantKey` deja la puerta abierta a multiempresa: hoy existe un único registro
// ("default"); mañana cada restaurante tendrá su propia fila con su propia key.
model RestaurantSettings {
  id        Int    @id @default(autoincrement())
  tenantKey String @unique @default("default") @db.VarChar(60)

  // ─── Marca ───
  restaurantName    String  @default("Mi Restaurante") @db.VarChar(120)
  appName           String  @default("Quiosco") @db.VarChar(60)
  slogan            String? @db.VarChar(200)
  // Text (no VarChar) porque las imágenes se guardan como data URL base64:
  // funciona en Vercel serverless sin depender del sistema de archivos.
  logoUrl           String? @db.Text
  darkLogoUrl       String? @db.Text
  faviconUrl        String? @db.Text
  loginBackgroundUrl String? @db.Text

  // ─── Colores (hex) ───
  primaryColor    String @default("#d4a017") @db.VarChar(9)
  secondaryColor  String @default("#1f2937") @db.VarChar(9)
  accentColor     String @default("#0ea5e9") @db.VarChar(9)
  successColor    String @default("#16a34a") @db.VarChar(9)
  warningColor    String @default("#f59e0b") @db.VarChar(9)
  dangerColor     String @default("#dc2626") @db.VarChar(9)
  backgroundColor String @default("#f7f5f1") @db.VarChar(9)
  textColor       String @default("#1f2937") @db.VarChar(9)

  // ─── Apariencia ───
  fontFamily String @default("Inter") @db.VarChar(80)
  fontSize   String @default("md") @db.VarChar(10) // sm | md | lg
  themeMode  String @default("light") @db.VarChar(10) // light | dark | auto

  // ─── Empresa ───
  ruc      String? @db.VarChar(20)
  address  String? @db.VarChar(300)
  phone    String? @db.VarChar(40)
  email    String? @db.VarChar(150)
  website  String? @db.VarChar(200)
  currency String  @default("PEN") @db.VarChar(10)
  timezone String  @default("America/Lima") @db.VarChar(60)

  // Redes sociales como JSON: { facebook, instagram, tiktok, whatsapp, ... }
  socialLinks Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}
